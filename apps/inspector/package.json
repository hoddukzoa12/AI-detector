{
  "name": "public-site-ad-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --no-warn-ignored",
    "test": "vitest run --exclude 'test/e2e/**'",
    "build": "node scripts/build.mjs",
    "test:e2e": "vitest run test/e2e",
    "package:win": "node scripts/package-win.mjs",
    "verify:win": "node scripts/verify-win.mjs",
    "self-test": "npm run build && node dist/self-test.mjs",
    "test:docker": "node scripts/docker-check.mjs",
    "docs:proposal": "node scripts/export-proposal.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "dotenv": "18.0.5",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
